{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-outputs/runbook-validate.schema.json",
  "title": "Stage 4: Runbook Validation Output",
  "description": "Cross-reference results of runbook procedures against current CMDB state.",
  "type": "object",
  "required": ["change_id", "findings"],
  "properties": {
    "change_id": { "type": "string" },
    "findings": {
      "type": "array",
      "items": { "$ref": "../finding.schema.json" }
    }
  },
  "additionalProperties": false
}
