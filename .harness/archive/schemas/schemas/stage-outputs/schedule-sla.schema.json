{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-outputs/schedule-sla.schema.json",
  "title": "Stage 6: Schedule & SLA Analysis Output",
  "description": "Cross-CR scheduling overlap detection and SLA budget impact using interval-union math. Degrades to overlap-only when sla_definitions absent (BPI 2014: 97% missing Scheduled Downtime).",
  "type": "object",
  "required": ["scheduling_conflicts", "sla_impact", "sla_analysis_mode"],
  "properties": {
    "sla_analysis_mode": {
      "type": "string",
      "enum": ["full", "overlap_only", "not_applicable"],
      "description": "full = tier breach math; overlap_only = scheduling conflicts only; not_applicable = no schedule/SLA inputs"
    },
    "scheduling_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cr_pair", "shared_services", "overlap_window", "severity"],
        "properties": {
          "cr_pair": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "shared_services": {
            "type": "array",
            "items": { "type": "string" }
          },
          "overlap_window": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" }
            }
          },
          "severity": { "type": "string", "enum": ["blocker", "warning", "info"] }
        },
        "additionalProperties": false
      }
    },
    "sla_impact": {
      "type": "array",
      "description": "Per-tier SLA budget impact using interval-union (not sum) of maintenance windows",
      "items": {
        "type": "object",
        "required": ["tier", "union_downtime_min", "remaining_budget_min", "breach", "severity"],
        "properties": {
          "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
          "union_downtime_min": {
            "type": "number",
            "description": "Merged interval duration — overlapping windows count once"
          },
          "remaining_budget_min": { "type": "number" },
          "breach": { "type": "boolean" },
          "severity": { "type": "string", "enum": ["blocker", "warning", "info"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
