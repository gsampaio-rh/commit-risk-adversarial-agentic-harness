{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-outputs/dependency-chain.schema.json",
  "title": "Stage 7: Dependency Chain Output",
  "description": "CMDB service graph analysis — ordering violations, circular deps, blast radius. Window-level output.",
  "type": "object",
  "required": ["ordering_violations", "circular_deps", "blast_radius"],
  "properties": {
    "ordering_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cr_pair", "dependency_path", "severity"],
        "properties": {
          "cr_pair": {
            "type": "array",
            "description": "[prerequisite_id, dependent_id]",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "dependency_path": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Service IDs in the dependency chain"
          },
          "severity": { "type": "string", "enum": ["blocker", "warning", "info"] }
        },
        "additionalProperties": false
      }
    },
    "circular_deps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle", "involved_crs"],
        "properties": {
          "cycle": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Service IDs forming the cycle"
          },
          "involved_crs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "blast_radius": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "downstream_services", "max_depth"],
        "properties": {
          "change_id": { "type": "string" },
          "downstream_services": {
            "type": "array",
            "items": { "type": "string" }
          },
          "max_depth": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
